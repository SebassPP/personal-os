# Copia este archivo a .env.local y completa los valores reales.
# Los encuentras en el panel de Supabase: Project Settings -> API.

# URL del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon). Es segura de exponer en el navegador siempre que
# todas las tablas tengan RLS activada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
